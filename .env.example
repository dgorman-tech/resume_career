# Copy this file to .env (at the repo root) and fill in your key.
# .env is gitignored — it's yours alone, never committed.
#
# Both the app and the watcher load .env automatically at startup. This is
# the easiest way to set GEMINI_API_KEY for a scheduled/unattended watcher
# run, since a shell `export` doesn't carry over to Task Scheduler/cron —
# see SETUP.md. A real OS-level environment variable, if you already have
# one set, always takes priority over this file.

GEMINI_API_KEY=your-gemini-api-key-here
