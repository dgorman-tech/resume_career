# Secrets / personal config (target companies, ntfy topic)
watcher/config.json
watcher/config.json.bak*
watcher/config.json.tmp

# Generated data — job listings, salary data, personal digests.
# A backup of the database is exactly as sensitive as the database, so this class
# fails closed: watcher.db* covers the -wal/-shm sidecars and any .bak/.tmp/.old
# copy, and *.db catches a copy saved under a different name.
watcher/watcher.db*
watcher/*.db
watcher/watcher.log
watcher/watcher.log.*
watcher/digests/
watcher/job-board.html
watcher/latest-digest.html
watcher/latest-digest.md
watcher/weekly-brief-*.md

# Python
__pycache__/
*.pyc

# Career HQ app — local artifacts
.superpowers/
docs/superpowers/
node_modules/
web/dist/
.env
.worktrees/

# Personal career strategy & documents — not for public repo
Career Intelligence Report.md
Career North Star.md
Job Search Strategy.md
LinkedIn Refresh.md
Target Rankings.md
Tooling Roadmap.md
*Resume*.docx
*Resume*.pdf
scripts/seed_profile.py

# Privacy scan — your own name/company terms (see scripts/privacy_patterns.local.json.example)
scripts/privacy_patterns.local.json
